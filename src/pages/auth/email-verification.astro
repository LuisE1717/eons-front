---

import { getI18N } from "../../i18n";
import configEnv from "../../../.env_config.ts";

const currentLocale = Astro.cookies.get('eons_lng')?.value || 'es';
const i18 = getI18N({ currentLocale });

// Obtener parámetros de la URL para mostrar mensajes
const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const fromLogin = url.searchParams.get('fromLogin');

// Configuración unificada: solo cambian las URLs según las variables de entorno
const baseUrl = configEnv.frontend;
const apiUrl = configEnv.api;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Valide su cuenta de correo - EONS</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background-color: #f8f9fa;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
      }
      
      .container {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        max-width: 450px;
        width: 100%;
        padding: 2rem;
      }
      
      .header {
        text-align: center;
        margin-bottom: 2rem;
      }
      
      .header img {
        max-width: 220px;
        height: auto;
      }
      
      .message-container {
        text-align: center;
        margin-bottom: 2rem;
      }
      
      .message-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
      }
      
      .message-text {
        color: #666;
        line-height: 1.5;
        font-size: 0.95rem;
        margin-bottom: 1rem;
      }
      
      .icon {
        font-size: 3rem;
        margin-bottom: 1rem;
      }
      
      .success-icon {
        color: #28a745;
      }
      
      .warning-icon {
        color: #ffc107;
      }
      
      .button-container {
        text-align: center;
        margin: 1.5rem 0;
      }
      
      .button {
        background-color: #8a2be2;
        color: white;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
      }
      
      .button:hover {
        background-color: #7a1bd2;
      }
      
      .button:disabled {
        background-color: #cccccc;
        cursor: not-allowed;
      }
      
      .error {
        color: #dc3545;
        text-align: center;
        margin-top: 1rem;
        font-size: 0.9rem;
        background-color: #f8d7da;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #f5c6cb;
      }
      
      .success {
        color: #155724;
        text-align: center;
        margin-top: 1rem;
        font-size: 0.9rem;
        background-color: #d4edda;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #c3e6cb;
      }
      
      .info {
        color: #856404;
        text-align: center;
        margin-top: 1rem;
        font-size: 0.9rem;
        background-color: #fff3cd;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ffeaa7;
      }
      
      .countdown {
        color: #8a2be2;
        font-weight: bold;
      }
      
      .login-link {
        text-align: center;
        margin-top: 1.5rem;
      }
      
      .login-link a {
        color: #8a2be2;
        text-decoration: none;
      }
      
      .login-link a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <img
          src="/pixelcut-export.webp"
          alt="EONS"
        />
      </header>
      
      <div class="message-container">
        <div class="icon warning-icon">📧</div>
        <h1 class="message-title">Valide su cuenta de correo</h1>
        <p class="message-text">
          {fromLogin === 'true' 
            ? 'Para iniciar sesión, primero debe verificar su dirección de correo electrónico. Pronto recibirá un correo con la información de verificación.'
            : 'Pronto recibirá un correo con la información de verificación.'
          }
        </p>
        
        {error && (
          <p class="error">
            Error: {error}
          </p>
        )}
      </div>
      
      <div class="info">
        <strong>¿No ha llegado el correo?</strong>
        <p>Revise su carpeta de spam o solicite un nuevo correo de verificación.</p>
      </div>
      
      <div class="button-container">
        <button id="resendButton" class="button" onclick="resendVerification()">
          Reenviar correo
        </button>
      </div>
      
      <div id="successMessage" class="success" style="display: none;">
        ✅ Correo de verificación enviado exitosamente
      </div>
      
      <div id="errorMessage" class="error" style="display: none;">
        ❌ Error al enviar el correo. Intente nuevamente.
      </div>
      
      {fromLogin === 'true' && (
        <div class="login-link">
          <p>¿Ya verificó su correo? <a href={`${baseUrl}/auth`}>Volver al inicio de sesión</a></p>
        </div>
      )}
    </div>

    <script define:vars={{ apiUrl }}>
      let countdown = 60;
      let countdownInterval;

      function resendVerification() {
        const button = document.getElementById('resendButton');
        const successMessage = document.getElementById('successMessage');
        const errorMessage = document.getElementById('errorMessage');

        // Obtener el email del localStorage (asumiendo que se guardó durante el login/registro)
        const userEmail = localStorage.getItem('userEmail') || '';

        if (!userEmail) {
          errorMessage.textContent = '❌ No se encontró la dirección de correo. Por favor, inicie sesión nuevamente.';
          errorMessage.style.display = 'block';
          return;
        }

        // Deshabilitar el botón durante el countdown
        button.disabled = true;

        // Enviar solicitud al backend
        fetch(`${apiUrl}/auth/resend-verification`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: userEmail,
            lang: 'es'
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            successMessage.style.display = 'block';
            errorMessage.style.display = 'none';
            
            // Iniciar countdown de 60 segundos
            startCountdown();
          } else {
            throw new Error(data.message || 'Error al enviar el correo');
          }
        })
        .catch(error => {
          errorMessage.textContent = '❌ ' + error.message;
          errorMessage.style.display = 'block';
          successMessage.style.display = 'none';
          button.disabled = false;
          button.textContent = 'Reenviar correo';
        });
      }
      
      function startCountdown() {
        const button = document.getElementById('resendButton');
        countdown = 60;
        
        countdownInterval = setInterval(() => {
          countdown--;
          button.textContent = `Reenviar en ${countdown}s`;
          
          if (countdown <= 0) {
            clearInterval(countdownInterval);
            button.disabled = false;
            button.textContent = 'Reenviar correo';
          }
        }, 1000);
      }
      
      // Verificar si hay un mensaje de error en la URL
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('error')) {
        // Mostrar el error que viene del backend
        const errorMessage = document.getElementById('errorMessage');
        errorMessage.textContent = '❌ ' + decodeURIComponent(urlParams.get('error'));
        errorMessage.style.display = 'block';
      }
    </script>
  </body>
</html>