---
import { getI18N } from "../../i18n";

const currentLocale = Astro.cookies.get('eons_lng')?.value || 'es';
const i18 = getI18N({ currentLocale });

// Obtener parámetros de la URL para mostrar mensajes personalizados
const url = new URL(Astro.request.url);
const success = url.searchParams.get('success');
const message = url.searchParams.get('error'); // Cambiado a 'error' para coincidir con el backend
const email = url.searchParams.get('email');
const fromLogin = url.searchParams.get('fromLogin');
const userExists = url.searchParams.get('userExists');

// Configuración dinámica para producción/desarrollo
const isDevelopment = import.meta.env.ENV === "local";
const baseUrl = isDevelopment ? 'http://localhost:4321' : 'https://eons.es';

// Determinar la ruta correcta del login y services
const loginUrl = `${baseUrl}/auth`;
const servicesUrl = `${baseUrl}/services`; // ✅ CORRECCIÓN: Ruta a services
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verificado - EONS</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background-color: #f8f9fa;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
      }
      
      .container {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        max-width: 420px;
        width: 100%;
        padding: 2rem;
      }
      
      .header {
        text-align: center;
        margin-bottom: 2rem;
      }
      
      .header img {
        max-width: 220px;
        height: auto;
      }
      
      .message-container {
        text-align: center;
        margin-bottom: 2rem;
      }
      
      .message-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
      }
      
      .message-text {
        color: #666;
        line-height: 1.5;
        font-size: 0.95rem;
      }
      
      .success-icon {
        color: #28a745;
        font-size: 3rem;
        margin-bottom: 1rem;
      }
      
      .button-container {
        text-align: center;
      }
      
      .button {
        background-color: #8a2be2;
        color: white;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
      }
      
      .button:hover {
        background-color: #7a1bd2;
      }
      
      .error {
        color: #dc3545;
        text-align: center;
        margin-top: 1rem;
        font-size: 0.9rem;
      }
      
      .redirect-text {
        text-align: center;
        margin-top: 1.5rem;
        color: #888;
        font-size: 0.9rem;
      }
      
      .countdown {
        color: #8a2be2;
        font-weight: bold;
      }

      .info-box {
        background-color: #e7f3ff;
        border: 1px solid #b3d9ff;
        border-radius: 5px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .email-display {
        font-weight: bold;
        color: #8a2be2;
        word-break: break-all;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <img
          src="/pixelcut-export.webp"
          alt="EONS"
        />
      </header>

      <!-- Mostrar email si está disponible -->
      {email && (
        <div class="info-box">
          <p>Verification email sent to: <span class="email-display">{email}</span></p>
        </div>
      )}
      
      <div class="message-container">
        {success === 'true' ? (
          <>
            <div class="success-icon">✅</div>
            <h1 class="message-title">¡Email Verificado Exitosamente!</h1>
            <p class="message-text">
              Tu dirección de correo electrónico ha sido verificada correctamente. 
              Ahora puedes iniciar sesión y disfrutar de todos los servicios de EONS.
            </p>
          </>
        ) : userExists === 'true' ? (
          <>
            <div class="success-icon" style="color: #ffc107;">⚠️</div>
            <h1 class="message-title">Cuenta Existente</h1>
            <p class="message-text">
              Ya existe una cuenta con este email. Hemos enviado un nuevo correo de verificación.
              Por favor, verifica tu email para continuar.
            </p>
          </>
        ) : fromLogin === 'true' ? (
          <>
            <div class="success-icon" style="color: #17a2b8;">📧</div>
            <h1 class="message-title">Verificación Requerida</h1>
            <p class="message-text">
              Para iniciar sesión, primero debes verificar tu dirección de email.
              Hemos enviado un correo de verificación a tu dirección.
            </p>
          </>
        ) : (
          <>
            <div class="success-icon" style="color: #dc3545;">❌</div>
            <h1 class="message-title">Error en la Verificación</h1>
            <p class="message-text">
              {message || 'Ha ocurrido un error al verificar tu email. Por favor, intenta nuevamente.'}
            </p>
          </>
        )}
      </div>
      
      <div class="button-container">
        {success === 'true' ? (
          <a href={loginUrl} class="button"> {/* ✅ CORRECCIÓN: Cambiado a loginUrl */}
            Iniciar Sesión
          </a>
        ) : (
          <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
            {email && (
              <button 
                onclick="resendVerification()" 
                class="button"
                style="background-color: #17a2b8;"
              >
                Reenviar Verificación
              </button>
            )}
            <a href={loginUrl} class="button">
              Volver al Login
            </a>
          </div>
        )}
      </div>
      
      {success === 'true' && (
        <p class="redirect-text">
          Serás redirigido automáticamente a la página de login en <span id="countdown" class="countdown">5</span> segundos...
        </p>
      )}
      
      {message && success !== 'true' && (
        <p class="error">
          Error: {message}
        </p>
      )}
    </div>

    {success === 'true' && (
      <script>
        // ✅ CORRECCIÓN: Redirección automática después de 5 segundos a la página de LOGIN
        let seconds = 5;
        const countdownElement = document.getElementById('countdown');
        const loginUrl = '${loginUrl}';
        
        const countdown = setInterval(() => {
          seconds--;
          if (countdownElement) {
            countdownElement.textContent = seconds;
          }
          
          if (seconds <= 0) {
            clearInterval(countdown);
            window.location.href = loginUrl; 
          }
        }, 1000);
        
        setTimeout(() => {
          window.location.href = loginUrl; 
        }, 5000);
      </script>
    )}

    {email && (
      <script>
        async function resendVerification() {
          const button = event.target;
          const originalText = button.textContent;
          
          button.textContent = 'Enviando...';
          button.disabled = true;
          
          try {
            const response = await fetch('${isDevelopment ? 'http://localhost:3000' : 'https://api.eons.es'}/auth/resend-verification', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                email: '${email}',
                lang: 'es'
              })
            });
            
            const result = await response.json();
            
            if (result.success) {
              alert('✅ Correo de verificación reenviado exitosamente. Revisa tu bandeja de entrada.');
            } else {
              alert('❌ Error al reenviar el correo: ' + (result.message || 'Intenta nuevamente.'));
            }
          } catch (error) {
            console.error('Error:', error);
            alert('❌ Error de conexión. Por favor, intenta nuevamente.');
          } finally {
            button.textContent = originalText;
            button.disabled = false;
          }
        }
      </script>
    )}
  </body>
</html>