# ==============================================
# URLS DE LA APLICACIÓN
# ==============================================
# IMPORTANTE: Estas son las ÚNICAS variables que deben cambiar entre entornos.
# El comportamiento de la aplicación es idéntico en todos los entornos.
# Solo cambian las URLs de conexión.

# API Backend URL - Servidor (incluye WebSocket)
# NOTA: PUBLIC_ prefix es requerido por Astro para que esté disponible en el cliente (navegador)
# Desarrollo: http://localhost:3000
# Producción: https://api.eons.es
PUBLIC_API_BASE_URL=http://localhost:3000

# Frontend URL - Aplicación web
# Desarrollo: http://localhost:4321
# Producción: https://eons.es
PUBLIC_FRONTEND_BASE_URL=http://localhost:4321

# ==============================================
# AUTENTICACIÓN
# ==============================================
AUTH_SECRET=your-auth-secret-here
PUBLIC_AUTH_SECRET=your-public-auth-secret-here

# ==============================================
# GOOGLE OAUTH
# ==============================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ==============================================
# AZURE AD (MICROSOFT) OAUTH
# ==============================================
AZURE_AD_CLIENT_ID=your-azure-ad-client-id-here
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret-here
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id-here
